# ML Engine Configuration
ML_ENGINE_HOST=0.0.0.0
ML_ENGINE_PORT=8080
ENVIRONMENT=production

# FlowCraft Backend Integration
FLOWCRAFT_BACKEND_URL=http://localhost:4000
FLOWCRAFT_API_KEY=your_api_key_here

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=/app/logs/ml-engine.log

# Database Configuration (if needed)
MONGODB_URI=mongodb://localhost:27017/flowcraft
REDIS_URL=redis://localhost:6379/0

# Model Storage
MODEL_STORAGE_PATH=/app/models
DATA_STORAGE_PATH=/app/data

# Resource Limits
MAX_CONCURRENT_EXECUTIONS=5
MAX_EXECUTION_TIME_MINUTES=60
MAX_MEMORY_MB=2048

# GPU Configuration (if available)
CUDA_VISIBLE_DEVICES=0
USE_GPU=false

# Development Settings
RELOAD_ON_CHANGE=false
DEBUG_MODE=false
