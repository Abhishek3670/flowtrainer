    }
  },
  "deployment": {
    "environments": [
      {
        "name": "development",
        "url": "http://localhost:3000",
        "api_url": "http://localhost:4000",
        "description": "Local development environment"
      },
      {
        "name": "staging",
        "url": "https://staging.flowtrainer.app",
        "api_url": "https://api.staging.flowtrainer.app",
        "description": "Staging environment for testing"
      },
      {
        "name": "production",
        "url": "https://app.flowtrainer.com",
        "api_url": "https://api.flowtrainer.com",
        "description": "Production environment"
      }
    ],
    "ci_cd": {
      "provider": "GitHub Actions",
      "workflow_files": [
        ".github/workflows/ci.yml",
        ".github/workflows/cd-staging.yml",
        ".github/workflows/cd-production.yml"
      ]
    }
  },
  "analytics": {
    "enabled": true,
    "provider": "Google Analytics 4",
    "events": [
      {
        "name": "page_view",
        "description": "Track page views",
        "properties": ["page_path", "page_title"]
      },
      {
        "name": "button_click",
        "description": "Track button clicks",
        "properties": ["button_id", "button_text", "page_path"]
      },
      {
        "name": "form_submit",
        "description": "Track form submissions",
        "properties": ["form_name", "form_data"]
      },
      {
        "name": "error",
        "description": "Track client-side errors",
        "properties": ["error_message", "stack_trace", "component_stack"]
      }
    ],
    "privacy": {
      "anonymize_ip": true,
      "respect_dnt": true,
      "data_retention": "26 months"
    }
  },
  "error_handling": {
    "client_side": {
      "error_boundary": {
        "component": "ErrorBoundary",
        "fallback_ui": "ErrorFallback",
        "log_errors": true
      },
      "error_codes": {
        "AUTH_001": "Authentication failed",
        "AUTH_002": "Session expired",
        "API_001": "Network error",
        "API_002": "Server error",
        "VALIDATION_001": "Invalid input"
      }
    },
    "server_side": {
      "logging": {
        "level": "error",
        "format": "json",
        "transport": ["console", "file"]
      },
      "monitoring": {
        "enabled": true,
        "provider": "Sentry",
        "sample_rate": 1.0
      }
    }
  },
  "security": {
    "authentication": {
      "jwt": {
        "secret": "process.env.JWT_SECRET",
        "expires_in": "15m",
        "refresh_expires_in": "7d",
        "algorithm": "HS256"
      },
      "password_policy": {
        "min_length": 12,
        "require_uppercase": true,
        "require_lowercase": true,
        "require_numbers": true,
        "require_special_chars": true,
        "max_age_days": 90,
        "history_size": 5
      },
      "rate_limiting": {
        "login_attempts": 5,
        "lockout_time_minutes": 15,
        "requests_per_minute": 100
      }
    },
    "cors": {
      "allowed_origins": ["https://app.flowtrainer.com", "https://staging.flowtrainer.app"],
      "allowed_methods": ["GET", "POST", "PUT", "DELETE", "OPTIONS"],
      "allowed_headers": ["Content-Type", "Authorization"],
      "allow_credentials": true
    },
    "headers": {
      "content_security_policy": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https://api.flowtrainer.com;",
      "strict_transport_security": "max-age=31536000; includeSubDomains; preload",
      "x_content_type_options": "nosniff",
      "x_frame_options": "DENY",
      "x_xss_protection": "1; mode=block"
    },
    "session_management": {
      "http_only": true,
      "secure": true,
      "same_site": "Lax",
      "max_age_seconds": 604800
    },
    "data_protection": {
      "encryption_at_rest": true,
      "encryption_in_transit": true,
      "pii_handling": {
        "masking": ["password", "api_key", "access_token"],
        "redaction": ["credit_card", "ssn", "phone_number"]
      },
      "data_retention": {
        "user_data": "Until account deletion",
        "logs": "30 days",
        "backups": "90 days"
      }
    },
    "audit_logging": {
      "enabled": true,
      "log_level": "info",
      "events": [
        "user_login",
        "user_logout",
        "user_password_change",
        "user_role_change",
        "user_creation",
        "user_deletion",
        "data_access",
        "data_modification",
        "system_configuration_change"
      ],
      "retention_days": 365
    }
  },
  "testing_strategy": {
    "unit_tests": {
      "framework": "Jest",
      "coverage_threshold": 80,
      "test_files": ["**/*.test.{js,jsx,ts,tsx}"],
      "mock_strategy": "jest.mock"
    },
    "component_tests": {
      "framework": "React Testing Library",
      "test_files": ["**/*.spec.{js,jsx,ts,tsx}"],
      "coverage_threshold": 70
    },
    "integration_tests": {
      "framework": "Cypress",
      "test_files": ["cypress/e2e/**/*.cy.{js,jsx,ts,tsx}"],
      "coverage_threshold": 60
    },
    "api_tests": {
      "framework": "Supertest",
      "test_files": ["**/*.api.test.{js,ts}"],
      "coverage_threshold": 80
    },
    "performance_tests": {
      "framework": "Lighthouse CI",
      "thresholds": {
        "performance": 90,
        "accessibility": 90,
        "best-practices": 90,
        "seo": 80
      }
    },
    "test_environment": {
      "node_version": ">=16.0.0",
      "browsers": ["chrome", "firefox", "safari"],
      "test_database": "MongoDB Memory Server"
    },
    "test_coverage": {
      "collect_coverage": true,
      "coverage_reporters": ["text", "lcov", "clover"],
      "coverage_directory": "coverage"
    },
    "test_automation": {
      "ci_cd_integration": true,
      "pre_commit_hooks": ["lint-staged", "pretty-quick --staged"],
      "pre_push_hooks": ["npm test"]
    }
  },
