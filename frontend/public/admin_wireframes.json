  "performance_considerations": {
    "code_splitting": {
      "description": "Admin routes should be code-split to reduce initial bundle size",
      "implementation": "Use React.lazy() and Suspense for route-based code splitting"
    },
    "virtualization": {
      "description": "Use virtualization for long lists to improve rendering performance",
      "components": [
        "react-window",
        "react-virtualized"
      ]
    },
    "memoization": {
      "description": "Memoize expensive calculations and component renders",
      "hooks": [
        "useMemo",
        "useCallback",
        "React.memo"
      ]
    },
    "bundle_analysis": {
      "description": "Regularly analyze bundle size to identify optimization opportunities",
      "tools": [
        "webpack-bundle-analyzer",
        "source-map-explorer"
      ]
    }
  },
