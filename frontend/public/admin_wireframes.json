  "version_control": {
    "branch_strategy": "git-flow",
    "commit_message_format": "Conventional Commits (https://www.conventionalcommits.org/)",
    "branch_naming": {
      "feature": "feature/feature-name",
      "bugfix": "bugfix/description",
      "hotfix": "hotfix/description",
