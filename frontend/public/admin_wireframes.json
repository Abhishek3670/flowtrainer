                    "name": "enableAnimations",
                    "label": "Enable Animations",
                    "type": "switch",
                    "defaultValue": true
                  }
                ]
              }
            ],
            "onSubmit": "handleSaveConfig",
            "onReset": "handleResetConfig",
            "actions": [
              {
                "type": "button",
                "variant": "outlined",
                "color": "inherit",
                "onClick": "handleReset",
                "text": "Reset to Defaults"
              },
              {
                "type": "button",
                "variant": "contained",
                "color": "primary",
                "onClick": "handleSubmit",
                "text": "Save Changes"
              }
            ]
          }
        }
      ]
    }
  ],
