    {
      "id": "users",
      "name": "User Management",
      "path": "/admin/users",
      "description": "Manage system users and permissions",
      "components": [
        {
          "type": "UserList",
          "props": {
            "title": "Users",
            "columns": [
              { "field": "id", "headerName": "ID", "width": 100 },
              { "field": "name", "headerName": "Name", "width": 200 },
              { "field": "email", "headerName": "Email", "width": 250 },
              { 
                "field": "role", 
                "headerName": "Role", 
                "width": 150,
                "type": "singleSelect",
                "valueOptions": ["user", "admin", "super-admin"]
              },
              { 
                "field": "status", 
                "headerName": "Status", 
                "width": 120,
                "type": "boolean",
                "editable": true
              },
              { 
                "field": "lastLogin", 
                "headerName": "Last Login", 
                "width": 180,
                "type": "dateTime"
              },
              {
                "field": "actions",
                "headerName": "Actions",
                "width": 150,
                "type": "actions",
                "getActions": ["edit", "delete", "impersonate"]
              }
            ],
            "actions": [
              {
                "type": "button",
                "variant": "contained",
                "color": "primary",
                "startIcon": "Add",
                "text": "Add User",
                "onClick": "openAddUserDialog"
              },
              {
                "type": "button",
                "variant": "outlined",
                "startIcon": "Refresh",
                "text": "Refresh",
                "onClick": "refreshUsers"
              }
            ],
            "filters": [
              {
                "field": "role",
                "label": "Role",
                "type": "select",
                "options": [
                  { "value": "", "label": "All Roles" },
                  { "value": "user", "label": "User" },
                  { "value": "admin", "label": "Admin" },
                  { "value": "super-admin", "label": "Super Admin" }
                ]
              },
              {
                "field": "status",
                "label": "Status",
                "type": "select",
                "options": [
                  { "value": "", "label": "All Statuses" },
                  { "value": "active", "label": "Active" },
                  { "value": "inactive", "label": "Inactive" },
                  { "value": "suspended", "label": "Suspended" }
                ]
              },
              {
                "field": "search",
                "label": "Search",
                "type": "text",
                "placeholder": "Search users..."
              }
            ],
            "pagination": {
              "pageSize": 10,
              "pageSizeOptions": [10, 25, 50, 100]
            },
            "rowSelection": true,
            "bulkActions": [
              {
                "label": "Activate",
                "icon": "CheckCircle",
                "action": "activateUsers",
                "requireConfirmation": true
              },
              {
                "label": "Deactivate",
                "icon": "Cancel",
                "action": "deactivateUsers",
                "requireConfirmation": true
              },
              {
                "label": "Delete",
                "icon": "Delete",
                "action": "deleteUsers",
                "requireConfirmation": true,
                "color": "error"
              }
            ]
          }
        },
        {
          "type": "UserFormDialog",
          "props": {
            "open": "addUserDialogOpen",
            "onClose": "closeAddUserDialog",
            "title": "Add New User",
            "fields": [
              {
                "name": "name",
                "label": "Full Name",
                "type": "text",
                "required": true,
                "fullWidth": true,
                "margin": "normal"
              },
              {
                "name": "email",
                "label": "Email Address",
                "type": "email",
                "required": true,
                "fullWidth": true,
                "margin": "normal"
              },
              {
                "name": "role",
                "label": "Role",
                "type": "select",
                "required": true,
                "options": [
                  { "value": "user", "label": "User" },
                  { "value": "admin", "label": "Admin" },
                  { "value": "super-admin", "label": "Super Admin" }
                ],
                "fullWidth": true,
                "margin": "normal"
              },
              {
                "name": "sendInvitation",
                "label": "Send invitation email",
                "type": "checkbox",
                "defaultValue": true
              }
            ],
            "actions": [
              {
                "label": "Cancel",
                "onClick": "closeAddUserDialog",
                "color": "inherit"
              },
              {
                "label": "Create User",
                "type": "submit",
                "color": "primary",
                "variant": "contained"
              }
            ]
          }
        }
      ]
    },
