{
  "version": "1.0.0",
  "last_updated": "2025-09-14",
  "security_controls": {
    "authentication": {
      "jwt": {
        "algorithm": "RS256",
        "access_token_expiry": "15m",
        "refresh_token_expiry": "7d",
        "issuer": "flowtrainer-api",
        "audience": "flowtrainer-web",
        "token_refresh_grace_period": "5m",
        "token_invalidation": {
          "on_password_change": true,
          "on_role_change": true
        }
      },
      "password_policy": {
        "min_length": 12,
        "require_uppercase": true,
        "require_lowercase": true,
        "require_number": true,
        "require_special_char": true,
        "max_age_days": 90,
        "history_size": 5,
        "common_passwords_blacklist": true,
        "zxcvbn_min_score": 3
      },
      "multi_factor_auth": {
        "enabled": true,
        "required_for_admin": true,
        "methods": ["totp", "webauthn"],
        "recovery_codes_count": 10
      },
      "account_lockout": {
        "enabled": true,
        "max_attempts": 5,
        "duration_minutes": 15,
        "ip_whitelist": []
      }
    },
    "authorization": {
      "rbac_model": {
        "roles": ["super-admin", "admin", "user"],
        "permissions": [
          "users:read",
          "users:create",
          "users:update",
          "users:delete",
          "roles:manage",
          "audit:read"
        ],
        "role_permissions": {
          "super-admin": ["*"],
          "admin": [
            "users:read",
            "users:create",
            "users:update",
            "audit:read"
          ],
          "user": []
        }
      },
      "attribute_based_access_control": {
        "enabled": true,
        "attributes": ["department", "location", "team"],
        "policies": [
          {
            "effect": "allow",
            "action": "documents:read",
            "resource": "documents:${document.id}",
            "condition": {
              "equals": {
                "${document.owner}": "${user.id}"
              }
            }
          }
        ]
      }
    },
    "data_protection": {
      "encryption": {
        "at_rest": {
          "algorithm": "AES-256-GCM",
          "key_rotation_days": 90,
          "encrypted_fields": ["password", "api_keys", "tokens"]
        },
        "in_transit": {
          "tls_version": "1.3",
          "ciphers": [
            "TLS_AES_256_GCM_SHA384",
            "TLS_CHACHA20_POLY1305_SHA256"
          ],
          "hsts": {
            "max_age": 31536000,
            "include_subdomains": true,
            "preload": true
          }
        }
      },
      "data_retention": {
        "audit_logs": "365d",
        "user_data": "30d after account deletion",
        "backups": "1 year"
      },
      "masking": {
        "sensitive_fields": ["password", "api_key", "token", "ssn", "credit_card"],
        "masking_pattern": "******"
      }
    },
    "api_security": {
      "rate_limiting": {
        "enabled": true,
        "strategy": "token_bucket",
        "limits": {
          "authenticated": "1000/15m",
          "unauthenticated": "100/hour",
          "admin": "5000/15m"
        },
        "storage": {
          "type": "redis",
          "cluster_mode": true
        }
      },
      "input_validation": {
        "enabled": true,
        "content_type": ["application/json", "application/x-www-form-urlencoded"],
        "max_body_size": "10mb",
        "max_upload_size": "100mb",
        "allowed_file_types": ["image/jpeg", "image/png", "application/pdf"],
        "sanitization": {
          "html": true,
          "sql": true,
          "xss": true
        }
      },
      "cors": {
        "enabled": true,
        "allowed_origins": [
          "https://app.flowtrainer.com",
          "https://admin.flowtrainer.com"
        ],
        "allowed_methods": ["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"],
        "allowed_headers": ["Content-Type", "Authorization", "X-Requested-With"],
        "exposed_headers": ["X-RateLimit-Limit", "X-RateLimit-Remaining"],
        "max_age": 86400,
        "credentials": true
      },
      "graphql": {
        "introspection": false,
        "query_depth_limit": 10,
        "query_complexity_limit": 1000,
        "batch_requests_limit": 5
      },
      "http_security_headers": {
        "content_security_policy": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self';",
        "x_content_type_options": "nosniff",
        "x_frame_options": "DENY",
        "x_xss_protection": "1; mode=block",
        "referrer_policy": "strict-origin-when-cross-origin",
        "permissions_policy": "geolocation=(), microphone=(), camera=()",
        "strict_transport_security": "max-age=31536000; includeSubDomains; preload"
      }
    },
    "monitoring_and_logging": {
      "audit_logs": {
        "enabled": true,
        "storage": "elasticsearch",
        "retention_days": 365,
        "sensitive_fields_masking": true,
        "log_events": [
          "login_attempts",
          "permission_changes",
          "data_access",
          "configuration_changes"
        ]
      },
      "security_events": {
        "enabled": true,
        "siem_integration": true,
        "alert_rules": [
          {
            "id": "brute_force_attempt",
            "name": "Multiple Failed Login Attempts",
            "condition": "5+ failed login attempts in 5 minutes",
            "severity": "high",
            "action": ["alert_security_team", "block_ip_temporary"]
          }
        ]
      },
      "performance_metrics": {
        "enabled": true,
        "collection_interval": "60s",
        "metrics": ["response_time", "error_rate", "request_volume"]
      }
    },
    "infrastructure_security": {
      "container_security": {
        "image_scanning": true,
        "non_root_user": true,
        "read_only_root_filesystem": true,
        "capabilities_drop": ["ALL"],
        "no_new_privileges": true
      },
      "network_security": {
        "network_policies": {
          "deny_all_ingress": true,
          "deny_all_egress": true,
          "allowed_ingress": [
            {
              "port": 443,
              "protocol": "TCP",
              "source": "0.0.0.0/0"
            }
          ]
        },
        "service_mesh": {
          "enabled": true,
          "mutual_tls": true,
          "traffic_encryption": true
        }
      },
      "secrets_management": {
        "solution": "HashiCorp Vault",
        "key_rotation": {
          "enabled": true,
          "interval_days": 90
        },
        "secrets": ["database_credentials", "api_keys", "encryption_keys"]
      }
    },
    "compliance": {
      "gdpr": {
        "enabled": true,
        "data_processing_agreement": true,
        "data_protection_officer": "dpo@flowtrainer.com",
        "data_breach_notification_hours": 72
      },
      "hipaa": {
        "enabled": true,
        "baa_signed": true,
        "encryption_required": true
      },
      "soc2": {
        "enabled": true,
        "type": "SOC 2 Type 2",
        "audit_frequency": "annual"
      }
    }
  },
  "incident_response": {
    "process": {
      "detection": [
        "Automated monitoring alerts",
        "User reports",
        "Third-party notifications"
      ],
      "containment": [
        "Isolate affected systems",
        "Revoke compromised credentials",
        "Block malicious IPs"
      ],
      "eradication": [
        "Patch vulnerabilities",
        "Remove malware",
        "Update security controls"
      ],
      "recovery": [
        "Restore from clean backups",
        "Password resets",
        "System validation"
      ],
      "lessons_learned": [
        "Post-mortem analysis",
        "Update runbooks",
        "Team training"
      ]
    },
    "communication_plan": {
      "internal": [
        "Security team",
        "Engineering team",
        "Executive leadership"
      ],
      "external": [
        "Affected users",
        "Regulatory bodies",
        "Law enforcement (if applicable)"
      ],
      "timeline": {
        "initial_response": "1 hour",
        "internal_notification": "4 hours",
        "customer_notification": "72 hours (if required by law)",
        "regulatory_reporting": "As required by jurisdiction"
      }
    },
    "recovery_time_objective": "4 hours",
    "recovery_point_objective": "15 minutes"
  },
  "security_awareness_training": {
    "frequency": "quarterly",
    "topics": [
      "Phishing awareness",
      "Password security",
      "Social engineering",
      "Secure coding practices",
      "Incident reporting"
    ],
    "phishing_simulations": {
      "enabled": true,
      "frequency": "monthly",
      "metrics_tracking": true
    }
  },
  "third_party_risk_management": {
    "vendor_assessment": {
      "security_questionnaire": true,
      "soc2_reports": true,
      "penetration_testing": true
    },
    "contractual_requirements": [
      "Data protection clauses",
      "Security incident notification",
      "Right to audit"
    ],
    "continuous_monitoring": {
      "vulnerability_scans": true,
      "compliance_status": true,
      "threat_intelligence_feeds": true
    }
  },
  "implementation_timeline": {
    "phase_1": {
      "name": "Core Security Controls",
      "duration": "4 weeks",
      "milestones": [
        "Authentication and authorization",
        "API security controls",
        "Basic monitoring and logging"
      ]
    },
    "phase_2": {
      "name": "Advanced Protections",
      "duration": "8 weeks",
      "milestones": [
        "Container and network security",
        "Secrets management",
        "Advanced threat detection"
      ]
    },
    "phase_3": {
      "name": "Compliance and Maturity",
      "duration": "Ongoing",
      "milestones": [
        "Compliance certifications",
        "Security automation",
        "Continuous improvement"
      ]
    }
  },
  "responsibilities": {
    "security_team": [
      "Security architecture and implementation",
      "Incident response",
      "Security monitoring"
    ],
    "engineering_team": [
      "Secure coding practices",
      "Vulnerability remediation",
      "Security testing"
    ],
    "operations_team": [
      "Infrastructure security",
      "Patch management",
      "Backup and recovery"
    ],
    "compliance_team": [
      "Policy management",
      "Audit coordination",
      "Regulatory compliance"
    ]
  },
  "review_and_approval": {
    "security_lead": {
      "name": "[Security Lead Name]",
      "title": "Chief Information Security Officer",
      "signature": "",
      "date": ""
    },
    "cto": {
      "name": "[CTO Name]",
      "title": "Chief Technology Officer",
      "signature": "",
      "date": ""
    }
  },
  "revision_history": [
    {
      "version": "1.0.0",
      "date": "2025-09-14",
      "author": "[Author Name]",
      "changes": "Initial version"
    }
  ]
}
