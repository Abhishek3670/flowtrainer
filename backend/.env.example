# ===============================================================
#                GENERAL APPLICATION CONFIGURATION
# ===============================================================

# Set the application environment: 'development', 'production', or 'test'
NODE_ENV=development

# The port your application will run on
PORT=4000

# A long, complex, and random string for signing JWTs.
# You can generate one using an online tool or a command-line utility.
JWT_SECRET=<your_super_secret_and_long_jwt_key>


# ===============================================================
#                     DATABASE CONFIGURATION
# ===============================================================

# Primary database connection string
# Format: mongodb://[username:password@]host1[:port1][,...hostN[:portN]][/[database][?options]]
MONGO_URI=mongodb://localhost:27017/<your_database_name>

# Test database connection string
TEST_MONGO_URI=mongodb://localhost:27017/<your_test_database_name>

# MongoDB connection pool settings
MONGO_POOL_MIN=2
MONGO_POOL_MAX=10
MONGO_TIMEOUT=5000


# ===============================================================
#                    CACHING CONFIGURATION (REDIS)
# ===============================================================

# Redis connection URL
# Format: redis://[user:password@]host:port[/db-number]
REDIS_URL=redis://localhost:6379

# Cache Time-To-Live (TTL) in seconds for specific data types
CACHE_TTL_WORKFLOWS=60
CACHE_TTL_FILES=120


# ===============================================================
#                   FILE UPLOAD CONFIGURATION
# ===============================================================

# Maximum allowed file size for uploads (e.g., 10MB, 1GB)
MAX_FILE_SIZE=500MB

# The local directory path for storing uploaded files
UPLOAD_PATH=./uploads