{
  "compilerOptions": {
    // ===== LANGUAGE & MODULE SETTINGS =====
    
    "target": "ES2020",                    // Target ECMAScript version for compilation
    "module": "commonjs",                  // Module system (CommonJS for Node.js compatibility)
    "lib": ["ES2020"],                     // Library files to include (ES2020 features)
    
    // ===== OUTPUT CONFIGURATION =====
    
    "outDir": "./dist",                    // Output directory for compiled JavaScript
    "rootDir": "./src",                    // Root directory for source files
    
    // ===== TYPE CHECKING =====
    
    "strict": true,                        // Enable all strict type checking options
    "esModuleInterop": true,               // Enable ES module interop for CommonJS modules
    "skipLibCheck": true,                  // Skip type checking of declaration files
    "forceConsistentCasingInFileNames": true, // Ensure consistent file naming
    
    // ===== MODULE RESOLUTION =====
    
    "resolveJsonModule": true,             // Allow importing JSON files as modules
    "moduleResolution": "node",            // Use Node.js module resolution strategy
    "allowSyntheticDefaultImports": true,  // Allow default imports from modules without default exports
    
    // ===== DECLARATION FILES =====
    
    "declaration": true,                   // Generate corresponding .d.ts declaration files
    "declarationMap": true,                // Generate source maps for declaration files
    "types": ["jest", "node"],             // Include type definitions for Jest and Node.js
    "typeRoots": ["./node_modules/@types", "./src/types"], // Include custom type definitions
    "sourceMap": true,                     // Generate source maps for debugging
    
    // ===== CODE QUALITY =====
    
    "removeComments": true,                // Remove comments from output (keeps JSDoc)
    "noImplicitReturns": true,            // Report error when function doesn't return explicitly
    "noFallthroughCasesInSwitch": true,   // Report errors for fallthrough cases in switch statements
    
    // ===== DECORATOR SUPPORT =====
    
    "experimentalDecorators": true,       // Enable experimental decorator support
    "emitDecoratorMetadata": true,        // Emit decorator metadata for reflection
  },
  
  // ===== PROJECT STRUCTURE =====
  
  "include": [
    "src/**/*", 
    "src/types/**/*"                             // Include all files in src directory and subdirectories
  ],
  
  "exclude": [
    "src/**/*.test.ts",                    // Exclude test files
    "src/**/*.spec.ts",                    // Exclude spec files
    "src/controllers/__test__",            // Exclude test directories
    "node_modules",                        // Exclude dependencies
    "dist"                                 // Exclude build output
  ]
}
