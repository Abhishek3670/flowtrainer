{
  "name": "flowcraft-backend",
  "version": "1.0.0",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
    "build": "tsc",
    "profile:memory": "ts-node src/profiling/memory-profiler.ts",
    "load-test": "autocannon -c 10 -d 30 http://localhost:4000/api/health",
    "test": "jest",
    "test:auth": "NODE_ENV=test jest tests/auth.test.ts --detectOpenHandles --forceExit",
    "test:stress": "jest --testPathPattern=connection.test.ts --testNamePattern='stress'",
    "test:connection": "jest --testPathPattern=connection.test.ts",
    "test:cache": "ts-node backend/src/cache/testCache.ts",
    "db:indexes": "ts-node src/database/createIndexes.ts",
    "db:clean-indexes": "ts-node src/database/createIndexes.ts --clean",
    "db:list-indexes": "ts-node src/database/createIndexes.ts --list",
    "redis:up": "docker-compose -f docker-compose.redis.dev.yml up -d",
    "redis:down": "docker-compose -f docker-compose.redis.dev.yml down",
    "cache:test": "ts-node src/cache/testCache.ts",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.{ts,js,json,md}\"",
    "db:migrate": "node -r dotenv/config src/database/migrate.js up",
    "db:rollback": "node -r dotenv/config src/database/migrate.js down",
    "db:status": "node -r dotenv/config src/database/migrate.js status",
    "admin:init": "node -r dotenv/config scripts/init-admin.js",
    "seed:admin": "ts-node scripts/seed-admin.ts"
  },
  "nodemonConfig": {
    "watch": [
      "src"
    ],
    "ext": "ts,js",
    "ignore": [
      "data/**/*",
      "workflows/**/*",
      "results/**/*",
      "**/*.json"
    ]
  },
  "dependencies": {
    "@types/express-rate-limit": "^5.1.3",
    "@types/helmet": "^0.0.48",
    "@types/joi": "^17.2.2",
    "@types/winston": "^2.4.4",
    "axios": "^1.11.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.1.0",
    "express-validation": "^4.1.1",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "joi": "^18.0.1",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.19.0",
    "mongoose": "^7.5.0",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.7",
    "proper-lockfile": "^4.1.2",
    "rate-limiter-flexible": "^7.3.1",
    "redis": "^5.8.2",
    "socket.io": "^4.7.2",
    "uuid": "^11.1.0",
    "winston": "^3.18.3",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/bcryptjs": "^2.4.2",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/express-validator": "^2.20.33",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/mongoose": "^5.11.97",
    "@types/morgan": "^1.9.4",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.19.10",
    "@types/nodemailer": "^7.0.2",
    "@types/pidusage": "^2.0.5",
    "@types/proper-lockfile": "^4.1.4",
    "@types/redis": "^4.0.10",
    "@types/supertest": "^2.0.16",
    "0x": "^4.1.4",
    "autocannon": "^8.0.0",
    "clinic": "^13.0.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "pidusage": "^4.0.1",
    "supertest": "^6.3.4",
    "systeminformation": "^5.27.7",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.9.2"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "src/**/*.{ts,js}": [
      "npm run lint",
      "npm run format",
      "git add"
    ]
  }
}
